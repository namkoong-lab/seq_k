__pycache__/
*.pyc
.env
.venv/
seqk/

# All run outputs live only on disk for the runner's reference; the canonical
# copy is in s3://seq-k/. Do not commit — they're large, ephemeral, and Harbor's
# raw trial artifacts can carry unredacted secrets from task fixtures
# (asciinema recordings, terminal pane dumps, verifier stdout).
runs/

# Local-only scratch: report drafts and the ad-hoc shell scripts used to drive
# the experiment grids. Kept for reference, not part of the codebase.
old/

.DS_Store

# Harbor container scratch (trajectories, .cast recordings, verifier stdout).
# Kept OUT of runs/ so the results tree stays uploadable and secret-free.
harbor_jobs/

# Generated documents. The schema's source of truth is db/schema.sql; a rendered
# description of it (LaTeX, PDF) and any exported status spreadsheet are outputs,
# regenerated on demand and stale the moment the schema moves.
*.xlsx
~$*.xlsx
*.tsv
db/schema.tex
db/schema.pdf
*.aux
*.log
*.out
*.synctex.gz

# Database snapshots. Postgres is DERIVED — every row is rebuilt from
# runs/*/manifest.json by `db_sync.py --reset --rebuild`, and the shared copy is
# Neon. A dump committed here would be a second source of truth that silently
# goes stale; there is deliberately nowhere for one to live in the repo.
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db-journal
